# PostgreSQL asíncrono (asyncpg)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/passport

# Firma de tokens JWT (generar con: python -c "import secrets; print(secrets.token_hex(32))")
JWT_SECRET=cambia-este-secreto-por-uno-generado-de-forma-segura
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cookies: Secure=true exige HTTPS. En local con HTTP puro usar false
COOKIE_SECURE=true
COOKIE_SAMESITE=lax